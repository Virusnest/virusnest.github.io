---
layout: layouts/base.njk
---
    {% for post in collections.post | reverse %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title | default("Untitled Post") }}</a> —
        <time datetime="{{ post.date }}"></time>
      </li>
    {% else %}
      <li>No posts found.</li>
    {% endfor %}
